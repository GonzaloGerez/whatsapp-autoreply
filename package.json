{
  "name": "whatsapp-autoreply",
  "version": "0.1.0",
  "private": true,
  "description": "PoC portable de un bot de respuesta automática con la WhatsApp Cloud API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "start": "node src/server.js",
    "start:example": "node examples/custom-reply.js",
    "test": "node --test"
  }
}
