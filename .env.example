# Token de la app de Meta (system user o token temporal del panel).
WHATSAPP_ACCESS_TOKEN=

# ID del número, no el teléfono. Aparece en API Setup de la app.
WHATSAPP_PHONE_NUMBER_ID=

# Secreto compartido que vos elegís y cargás al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=

# App Secret de Meta. Si está vacío, el POST del webhook no valida la firma.
WHATSAPP_APP_SECRET=

# Versión del Graph API. La doc oficial de envío usa v27.0.
WHATSAPP_API_VERSION=v27.0

PORT=3000
WEBHOOK_PATH=/webhook
